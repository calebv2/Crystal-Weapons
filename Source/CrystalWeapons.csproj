<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CrystalWeapons</AssemblyName>
    <RootNamespace>CrystalWeapons</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GamePath>/game</GamePath>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <OutputPath>../Crystal Weapons Build/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(GamePath)/MelonLoader/net35/MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GamePath)/MelonLoader/net35/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Root.Township"><HintPath>$(GamePath)/A Township Tale_Data/Managed/Root.Township.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Alta.Values"><HintPath>$(GamePath)/A Township Tale_Data/Managed/Alta.Values.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GamePath)/A Township Tale_Data/Managed/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(GamePath)/A Township Tale_Data/Managed/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Core.cs" />
    <Compile Include="CrystalForgeConfig.cs" />
    <Compile Include="CrystalMaterialRegistration.cs" />
    <Compile Include="CrystalAppearancePolicy.cs" />
    <Compile Include="CrystalMouldTarget.cs" />
    <Compile Include="CrystalMouldRecipeRegistration.cs" />
    <Compile Include="CrystalSmelterInputFilter.cs" />
    <Compile Include="CrystalSmelterRecipeGate.cs" />
    <Compile Include="CrystalMouldOutputMaterialPatch.cs" />
    <Compile Include="PatchTargetResolver.cs" />
  </ItemGroup>
</Project>
